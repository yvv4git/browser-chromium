# Browser image version: default | optimized | selkies | headless | nokk
BROWSER_VARIANT=default

# Browser mode for the optimized image: vnc | headless
BROWSER_MODE=vnc

RESOLUTION=1920x1080

# Container memory limit
MEM_LIMIT=100m

# Selkies variant only: basic-auth login for the web UI (empty = no login)
# SELKIES_BASIC_AUTH_PASSWORD=secret

# Proxy (optional, uncomment to use)
# PROXY=http://host.docker.internal:8138

# Extra Chrome args (optional)
# CHROME_ARGS_EXTRA=--headless=new

# Extra nokk args (optional, nokk variant only)
# NOKK_ARGS=--rotate-fingerprint
