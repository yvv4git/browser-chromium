# Browser image version: default | optimized
BROWSER_VARIANT=default

# Browser mode for the optimized image: vnc | headless
BROWSER_MODE=vnc

RESOLUTION=1920x1080

# Proxy (optional, uncomment to use)
# PROXY=http://host.docker.internal:8138

# Extra Chrome args (optional)
# CHROME_ARGS_EXTRA=--headless=new
